# PostgreSQL database connection URL (with SSL for cloud databases like Render PostgreSQL)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Secret key used for signing and verifying JWT authentication tokens (use a long random string in production)
JWT_SECRET=your_production_jwt_secret_key_min_32_chars

# Expiration duration for issued JWT tokens (e.g., 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# Port assigned by the hosting environment or default server port
PORT=4000

# Application environment mode (production or development)
NODE_ENV=production

# Allowed frontend origin URL(s) for CORS policy (e.g., https://your-app.vercel.app or comma-separated list)
FRONTEND_URL=https://your-crm-frontend.vercel.app
